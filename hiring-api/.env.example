APP_NAME=HiringMachine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5757

# Docker Ports Configuration
APP_PORT=5757
DB_PORT=5858
MAIL_PORT=5959
MAIL_UI_PORT=8025

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hiringmachine
DB_USERNAME=hiringmachine
DB_PASSWORD=secret

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@hiringmachine.com"
MAIL_FROM_NAME="${APP_NAME}"

# Redis Configuration (optional)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache/Session Driver
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# JWT / API Token (optional)
JWT_SECRET=
JWT_TTL=60

# HiringMachine Specific
HIRING_MACHINE_PREFIX=HM
HIRING_MACHINE_VERSION=1.0.0
